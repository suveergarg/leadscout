# Copy to .env and fill in. Only LEADSCOUT_REDDIT_CLIENT_ID/SECRET are required to run anything.

# Register a "script" app at https://www.reddit.com/prefs/apps (no username/password needed —
# read-only access uses application-only OAuth). The client secret is the string under "secret".
LEADSCOUT_REDDIT_CLIENT_ID=
LEADSCOUT_REDDIT_CLIENT_SECRET=

# Optional: without either of these, leads still get stored but every keyword match scores a
# flat 0.5 (KeywordOnlyClassifier) instead of a real LLM judgment.
# ANTHROPIC_API_KEY=
# LEADSCOUT_OLLAMA_URL=http://localhost:11434

# Optional overrides (defaults live in src/leadscout/config.py):
# LEADSCOUT_DB_PATH=leadscout.db
# LEADSCOUT_MIN_LLM_SCORE=0.4
# LEADSCOUT_POLL_INTERVAL_SECONDS=900
# LEADSCOUT_DASHBOARD_PORT=8100
